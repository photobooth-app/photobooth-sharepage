{
  "name": "photobooth-sharepage",
  "version": "1.0.0",
  "description": "Frontend for users to download shots they made in the Photobooth-App",
  "productName": "Photobooth Sharepage",
  "author": "Michael G <me@mgineer85.de>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.2",
    "@vueuse/core": "^14.4.0",
    "quasar": "^2.24.0",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@quasar/app-vite": "^3.4.0",
    "@types/node": "^25.9.5",
    "autoprefixer": "^10.5.4",
    "globals": "^17.9.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "@parcel/watcher@2.6.0": true
  }
}
