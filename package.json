{
  "name": "photobooth-sharepage",
  "version": "1.0.0",
  "description": "Frontend for users to download shots they made in the Photobooth-App",
  "productName": "Photobooth Sharepage",
  "author": "Michael G <me@mgineer85.de>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "@vueuse/core": "^15.0.0",
    "quasar": "^2.35.4",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@quasar/app-vite": "^3.10.4",
    "@types/node": "^26.0.0",
    "autoprefixer": "^10.6.2",
    "globals": "^17.14.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^1.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "@parcel/watcher@2.6.0": true
  }
}
